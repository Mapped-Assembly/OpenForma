        {
          "step_id": "prepare",
          "operation_id": "prepare",
          "depends_on": [],
          "preconditions": [],
          "description": "Gather a kitchen scale (1 g resolution or better), a thermometer (0.1 \u00b0C resolution preferred), two cups and a stirring spoon. Use plain potable water; warm water should be around 40 \u00b0C, never boiling. Use a stable surface away from children and pets. No heater, custom electronics or automated execution is required."
        },
        {
          "step_id": "inputs",
          "operation_id": "prepare",
          "depends_on": [
            "prepare"
          ],
          "preconditions": [],
          "description": "Weigh the declared warm and cool water portions and record both initial temperatures immediately before mixing. The receiving cup and spoon should start at the declared cool temperature. The declared 20 J/K effective cup/spoon capacity is an assumption: document the container, or supply a justified capacity before freezing. Include additional bodies as nodes if their heat capacity matters."
        },
        {
          "step_id": "freeze",
          "operation_id": "prepare",
          "depends_on": [
            "inputs"
          ],
          "preconditions": [],
          "description": "Check actual masses and temperatures against declared inputs. If outside their tolerances, update the native thermal quantities and freeze a new plan before mixing. This model recomputes heat capacities from declared mass and specific heat; do not edit predicted temperature by hand."
        },
        {
          "step_id": "mix",
          "operation_id": "contact",
          "depends_on": [
            "freeze"
          ],
          "preconditions": [],
          "description": "Combine the two portions in the receiving cup and stir gently. Keep all of the declared water in the system. Record any spill, transfer loss or initial-temperature drift; deviations invalidate the closed-system assumption."
        },
        {
          "step_id": "measure",
          "operation_id": "measure",
          "depends_on": [
            "mix"
          ],
          "preconditions": [],
          "description": "Record the well-mixed temperature at 60 seconds after contact (target \u00b15 seconds), without touching the cup wall with the probe. Record instrument resolution and defensible uncertainty. The model predicts an equilibrium endpoint, not the time needed to reach it. Record inadequate mixing, probe lag or appreciable ambient heat exchange as unmet assumptions."
        },
        {
          "step_id": "record",
          "operation_id": "measure",
          "depends_on": [
            "measure"
          ],
          "preconditions": [],
          "description": "Upload readings, timing, cup description and optional photographs. Repeat with fresh batches for repeatability. Unknown uncertainty or unsupported assumptions remain inconclusive; agreement alone does not prove adiabatic behavior."
        }
