@@ -0,0 +1,60 @@
+"""Regression checks for native schematic endpoint preservation."""
+from __future__ import annotations
+import unittest
+import xml.etree.ElementTree as ET
+from forma_core.electronics.models import ElectricalIR
+from forma_core.utils import generate_svg_schematic
+
+
+def circuit(count: int = 2) -> ElectricalIR:
+    """Create generic modules sharing two independent named nets."""
+    return ElectricalIR.model_validate({'artifact_id':'test','revision':1,'parts':[{'part_definition_id':'module','name':'Module & <test>','pins':[{'pin_id':'A','name':'A','pin_type':'Digital'},{'pin_id':'B','name':'B','pin_type':'Ground'}]}],'components':[{'object_id':f'object-{i}','ref_des':f'U{i}','part_definition_id':'module'} for i in range(count)],'nets':[{'net_id':name,'name':name,'net_type':kind,'pins':[{'ref_des':f'U{i}','pin_id':pin} for i in range(count)]} for name,kind,pin in [('signal','Digital','A'),('ground','Ground','B')]]})
+
+
+class PinSchematicTests(unittest.TestCase):
+    """No component-level deduplication may erase distinct electrical nets."""
+    def test_parallel_connections_preserved(self) -> None:
+        """Power/signal and return between the same pair remain distinct."""
+        root=ET.fromstring(generate_svg_schematic(circuit()))
+        pairs=[(e.attrib['data-pin'],e.attrib['data-net']) for e in root.iter() if 'data-pin' in e.attrib]
+        self.assertEqual(pairs.count(('A','signal')),2)
+        self.assertEqual(pairs.count(('B','ground')),2)
+
+    def test_many_modules_have_unique_positions_and_fit(self) -> None:
+        """Fallback module types cannot overlap or escape a fixed canvas."""
+        root=ET.fromstring(generate_svg_schematic(circuit(14)))
+        boxes=[]
+        for group in root.iter():
+            if 'data-component' in group.attrib:
+                box=next(e for e in group if e.tag.endswith('rect'))
+                boxes.append((box.attrib['x'],box.attrib['y']))
+                self.assertLess(float(box.attrib['y'])+float(box.attrib['height']),float(root.attrib['height']))
+        self.assertEqual(len(set(boxes)),14)
+
+    def test_xml_text_escaped(self) -> None:
+        """Names containing markup stay text, not XML elements."""
+        root=ET.fromstring(generate_svg_schematic(circuit()))
+        self.assertIn('Module & <test>',''.join(root.itertext()))
+
+    def test_unconnected_pin_remains_visible(self) -> None:
+        """Unconnected interfaces do not disappear from the output."""
+        doc=circuit();doc.nets=doc.nets[:1]
+        root=ET.fromstring(generate_svg_schematic(doc))
+        self.assertEqual(sum(e.attrib.get('data-net')=='UNCONNECTED' for e in root.iter()),2)
+
+    def test_legacy_document_still_renders(self) -> None:
+        """Existing callers retain the same endpoint-preserving interface."""
+        from forma_core.workspaces.projects.models import HardwareIntermediateRepresentation
+        native=circuit()
+        legacy=HardwareIntermediateRepresentation.model_validate({'components':[{'ref_des':c.ref_des,'name':'Generic module','part_number':'TEST','category':'module','quantity':1,'rationale':'Test fixture','pins':[p.model_dump() for p in native.parts[0].pins]} for c in native.components],'nets':[n.model_dump() for n in native.nets]})
+        root=ET.fromstring(generate_svg_schematic(legacy))
+        self.assertEqual(sum('data-pin' in e.attrib for e in root.iter()),4)
+
+    def test_unknown_endpoint_rejected(self) -> None:
+        """Mutable invalid input cannot generate a convincing incomplete picture."""
+        doc=circuit();doc.nets[0].pins[0].pin_id='missing'
+        with self.assertRaises(ValueError):generate_svg_schematic(doc)
+
+
+if __name__=='__main__':
+    unittest.main()
