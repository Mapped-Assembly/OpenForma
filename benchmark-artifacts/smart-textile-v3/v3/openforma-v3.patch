@@ -0,0 +1,99 @@
+"""Layered-material schema and composition tests independent of wearable fixtures."""
+from __future__ import annotations
+from copy import deepcopy
+import unittest
+from typing import Any
+from pydantic import ValidationError
+from forma_core.domains.base import fingerprint
+from forma_core.domains.registry import parse_domain, validate_domain
+from forma_core.domains.composition import DomainLink, LinkEndpoint, compose_product, validate_product
+from forma_core.mechanics.layers import inspect_layers
+
+
+def documents() -> list[dict[str, Any]]:
+    """Make a generic instrumented laminate with explicitly unknown properties."""
+    mechanical={'domain':'mechanical','schema_version':'1.0','artifact_id':'m','revision':1,'parts':[{'part_definition_id':name} for name in ['panel','backing','foil','coating']],'components':[{'object_id':name,'part_definition_id':name,'ref_des':name} for name in ['panel','backing','foil','coating']],'layered_assemblies':[{'stack_id':'stack','host_object_id':'panel','frame':'panel-local','normal':[0.,0.,1.],'warp_direction':[1.,0.,0.],'layers':[{'layer_id':'layer-'+name,'component_object_id':name,'role':role,'thickness_mm':thickness} for name,role,thickness in [('backing','contact',1.),('foil','conductor',.1),('coating','encapsulation',None)]],'joins':[{'join_id':'join-1','first_layer_id':'layer-backing','second_layer_id':'layer-foil','method':'laminated'},{'join_id':'join-2','first_layer_id':'layer-foil','second_layer_id':'layer-coating','method':'laminated'}]}]}
+    electrical={'domain':'electrical','schema_version':'1.0','artifact_id':'e','revision':1,'parts':[{'part_definition_id':'sensor','pins':[{'pin_id':'OUT','name':'OUT','pin_type':'Analog'}],'engineering':{'temperature_sensor':{'output_unit':'degC'}}}],'components':[{'object_id':'sensor','part_definition_id':'sensor','ref_des':'S1'}],'nets':[{'net_id':'measurement','name':'Measurement','net_type':'Signal','pins':[{'ref_des':'S1','pin_id':'OUT'}]}]}
+    thermal={'domain':'thermal','schema_version':'1.0','artifact_id':'t','revision':1,'nodes':[{'node_id':'surface','kind':'body'}]}
+    human={'domain':'human','schema_version':'1.0','artifact_id':'h','revision':1,'profiles':[{'profile_id':'nominal','revision':1,'source':{'kind':'synthetic','description':'Test only'},'segments':[{'segment_id':'hand','label':'Hand'}]}],'participants':[{'participant_id':'operator','profile_id':'nominal','profile_revision':1,'roles':['operator'],'interfaces':[{'port_id':'contact','kind':'mechanical_contact','segment_id':'hand','description':'Contact'},{'port_id':'heat','kind':'thermal_exchange','segment_id':'hand','description':'Heat exchange'}]}]}
+    return [mechanical,electrical,thermal,human]
+
+
+def bundle() -> Any:
+    """Compose all supported coupling types through the public existing API."""
+    docs=[parse_domain(d) for d in documents()];by_id={d.artifact_id:d for d in docs}
+    def endpoint(artifact: str, object_id: str, port: str | None = None) -> LinkEndpoint:
+        """Pin the exact native artifact revision and content."""
+        return LinkEndpoint(artifact_id=artifact,revision=1,sha256=fingerprint(by_id[artifact]),object_id=object_id,port_id=port)
+    links=[DomainLink(link_id='mount',kind='mounted_on_layer',source=endpoint('e','sensor'),target=endpoint('m','layer-foil')),
+           DomainLink(link_id='observe',kind='observes_temperature',source=endpoint('e','sensor'),target=endpoint('t','surface')),
+           DomainLink(link_id='represent',kind='thermal_representation',source=endpoint('m','layer-backing'),target=endpoint('t','surface')),
+           DomainLink(link_id='contact',kind='wearer_contact',source=endpoint('h','operator','contact'),target=endpoint('m','layer-backing')),
+           DomainLink(link_id='heat',kind='thermal_contact',source=endpoint('h','operator','heat'),target=endpoint('t','surface','heat'))]
+    return compose_product('instrumented-panel',docs,links=links)
+
+
+class LayeredMaterialTests(unittest.TestCase):
+    """Reject false coupling claims while keeping unknown physics explicit."""
+    def test_valid_composition_and_unknown_thickness(self) -> None:
+        """Structural validity never converts absent values into physical results."""
+        result=validate_product(bundle());self.assertTrue(result.is_valid,result.model_dump())
+        document=parse_domain(documents()[0]);self.assertIsNone(inspect_layers(document)[0]['total_thickness_mm'])
+        self.assertTrue(any(f.code=='unknown_layer_thickness' for f in validate_domain(document)))
+        self.assertEqual(inspect_layers(document)[0]['deformation_prediction'],'unsupported')
+
+    def test_nonadjacent_join_and_duplicate_occurrence(self) -> None:
+        """Bad construction topology cannot masquerade as an ordered laminate."""
+        raw=documents()[0];raw['layered_assemblies'][0]['joins'][0]['second_layer_id']='layer-coating'
+        with self.assertRaises(ValidationError):parse_domain(raw)
+        raw=documents()[0];raw['layered_assemblies'][0]['layers'][1]['component_object_id']='backing'
+        with self.assertRaises(ValidationError):parse_domain(raw)
+
+    def test_invalid_material_frame_and_nonfinite_properties(self) -> None:
+        """Reject ambiguous axes and impossible numeric declarations."""
+        raw=documents()[0];raw['layered_assemblies'][0]['warp_direction']=[0.,0.,1.]
+        with self.assertRaises(ValidationError):parse_domain(raw)
+        raw=documents()[0];raw['parts'][1]['flexibility']={'warp_modulus_pa':float('nan')}
+        with self.assertRaises(ValidationError):parse_domain(raw)
+
+    def test_wrong_layer_and_internal_contact(self) -> None:
+        """An ordinary component is not a layer; an internal foil is not exposed."""
+        value=bundle();value.manifest.links[0].target.object_id='panel'
+        self.assertTrue(any(f.code=='layer_coupling' for f in validate_product(value).composition))
+        value=bundle();value.manifest.links[3].target.object_id='layer-foil'
+        self.assertTrue(any(f.code=='layer_coupling' for f in validate_product(value).composition))
+
+    def test_stale_revision_and_digest_invalidate_links(self) -> None:
+        """Composition pins cannot remain valid after independent artifact changes."""
+        value=bundle();value.manifest.links[0].target.revision=2
+        self.assertTrue(any(f.code=='link_revision' for f in validate_product(value).composition))
+        value=bundle();value.manifest.links[0].target.sha256='0'*64
+        self.assertTrue(any(f.code=='link_hash' for f in validate_product(value).composition))
+
+    def test_temperature_observation_requires_sensor_role(self) -> None:
+        """A controller or passive component cannot be labelled a temperature sensor."""
+        raw=documents();raw[1]['parts'][0]['engineering']=None
+        value=compose_product('instrumented-panel',[parse_domain(d) for d in raw],links=bundle().manifest.links)
+        self.assertTrue(any(f.code=='layer_coupling' and f.location=='observe' for f in validate_product(value).composition))
+
+    def test_entity_collision_and_unknown_component_rejected(self) -> None:
+        """Synthetic layer IDs must not shadow physical component IDs."""
+        raw=documents()[0];raw['layered_assemblies'][0]['stack_id']='panel'
+        with self.assertRaises(ValidationError):parse_domain(raw)
+        raw=documents()[0];raw['layered_assemblies'][0]['layers'][0]['component_object_id']='missing'
+        with self.assertRaises(ValidationError):parse_domain(raw)
+
+    def test_legacy_payloads_have_no_new_default_keys(self) -> None:
+        """Absent extensions preserve normalized legacy serialization and hashes."""
+        document=parse_domain({'domain':'mechanical','schema_version':'1.0','artifact_id':'m','revision':1,'parts':[{'part_definition_id':'part'}]})
+        data=document.model_dump(mode='json');self.assertNotIn('layered_assemblies',data);self.assertNotIn('flexibility',data['parts'][0])
+
+    def test_same_object_with_layer_metadata_returns_finding(self) -> None:
+        """New entity kinds cannot crash legacy shared-component validation."""
+        value=bundle();link=value.manifest.links[0];link.kind='same_object';link.target.object_id='layer-foil'
+        # Unequal identities are diagnosed without stopping the validator.
+        result=validate_product(value);self.assertTrue(any(f.code=='physical_identity' for f in result.composition))
+
+
+if __name__=='__main__':
+    unittest.main()
