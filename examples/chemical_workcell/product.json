      "steps": [
        {
          "step_id": "prepare",
          "operation_id": "solid-feed",
          "depends_on": [],
          "preconditions": [],
          "description": "Use food-grade baking soda and ordinary food vinegar only. Work in an open, stable bowl of at least 500 mL on a tray; never seal the vessel. Avoid eyes, do not taste the experimental mixture, and keep children/pets away. Gather a scale with 0.01 g resolution, thermometer, 50 mL measuring vessel, small powder cup, spoon and timer. Use the linked MechanicalIR workcell. Verify balance capacity with the complete tray assembly, platform support and 0.01 g resolution; record calibration/uncertainty. The PHONE, stock containers and measuring vessel stay outside the before/after weighing boundary."
        },
        {
          "step_id": "inputs",
          "operation_id": "vinegar-feed",
          "depends_on": [
            "prepare"
          ],
          "preconditions": [],
          "description": "Confirm the vinegar label basis is 5 g acetic acid per 100 mL (or independently establish acid inventory). An unspecified 5% is insufficient. Measure 50 mL vinegar and 2.00 g sodium bicarbonate. Record actual amounts, label photograph and uncertainty. If quantities or basis differ, revise and freeze a new plan BEFORE mixing. The calculation assumes nominal inputs and does not propagate feed uncertainty."
        },
        {
          "step_id": "before",
          "operation_id": "react",
          "depends_on": [
            "inputs"
          ],
          "preconditions": [],
          "description": "Record ambient temperature. Weigh the entire tray, bowl with vinegar, powder cup with bicarbonate, and spoon together; record initial total mass. All these items must remain in the final weighed system."
        },
        {
          "step_id": "mix",
          "operation_id": "react",
          "depends_on": [
            "before"
          ],
          "preconditions": [],
          "description": "Slowly add the powder to the vinegar in the open bowl, keeping the empty cup and spoon on the tray. Stir gently without splashing. Record start time and any spills or losses. Keep the vessel open throughout."
        },
        {
          "step_id": "after",
          "operation_id": "gas-output",
          "depends_on": [
            "mix"
          ],
          "preconditions": [],
          "description": "After visible bubbling subsides, take mass readings one minute apart until two consecutive readings differ by no more than 0.02 g, or stop at 15 minutes and mark incomplete. Record final total mass, elapsed time and a photograph of the final scale reading. A stable mass does not prove chemical completion."
        },
        {
          "step_id": "record",
          "operation_id": "residue-output",
          "depends_on": [
            "after"
          ],
          "preconditions": [],
          "description": "Submit the two total-mass readings, instrument resolution and defensible uncertainty bounds, temperature, evidence and deviations. Do not confirm proxy assumptions after a spill. Retain residue until readings are recorded; clean the ordinary food-ingredient mixture with water. Repeat with fresh independent batches to assess repeatability."
        }
      ],
