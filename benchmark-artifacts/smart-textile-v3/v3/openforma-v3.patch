@@ -0,0 +1,99 @@
+"""Headless host for declarative commands sent through MachineRuntime.
+
+This is a clock/transport host, not a second controller or motion interpolator.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any, Literal
+import numpy as np
+from pydantic import Field, FiniteFloat, model_validator
+from .models import ControlModel
+from .mujoco_adapter import MujocoAdapter, MujocoConfiguration
+from .runtime import MachineRuntime
+
+
+class CommandEvent(ControlModel):
+    """A timed external command; MachineRuntime supplies all interpolation."""
+    at_s: FiniteFloat = Field(ge=0)
+    label: str
+    op: Literal['move', 'hold'] = 'move'
+    targets: dict[str, FiniteFloat] = Field(default_factory=dict)
+    rates: dict[str, FiniteFloat] = Field(default_factory=dict)
+
+
+class RunRequest(ControlModel):
+    """Portable simulated run request, with no physical execution path."""
+    configuration: str
+    duration_s: FiniteFloat = Field(gt=0, le=120)
+    tick_s: FiniteFloat = Field(default=.01,gt=0,le=.02)
+    sample_s: FiniteFloat = Field(default=.04,gt=0)
+    events: list[CommandEvent]
+
+    @model_validator(mode='after')
+    def order(self) -> RunRequest:
+        """Reject unordered or out-of-run external commands."""
+        if [e.at_s for e in self.events] != sorted(e.at_s for e in self.events) or any(e.at_s>self.duration_s for e in self.events):
+            raise ValueError('Events must be ordered and inside run duration')
+        return self
+
+
+class SimulationClock:
+    """Deterministic host clock shared by runtime and adapter."""
+    def __init__(self) -> None:
+        """Start the run at zero host seconds."""
+        self.time=0.0
+    def __call__(self) -> float:
+        """Return elapsed host seconds."""
+        return self.time
+
+
+def run(request_path: Path, output: Path) -> dict[str, Any]:
+    """Execute a transcript and export actual simulator states and feedback."""
+    request=RunRequest.model_validate_json(request_path.read_text())
+    config_path=(request_path.parent/request.configuration).resolve()
+    config=MujocoConfiguration.model_validate_json(config_path.read_text())
+    clock=SimulationClock()
+    adapter=MujocoAdapter(config,config_path.parent,clock=clock)
+    runtime=MachineRuntime(config.definition,adapter,clock=clock)
+    if request.tick_s>config.definition.timing.update_ms/1000:
+        raise ValueError('Host tick exceeds runtime control period')
+    claim=runtime.claim('declarative simulation',kind='agent');session=claim['session_id'];seq=0
+
+    def send(op: str, **values: Any) -> None:
+        """Send a leased version-2 command through the existing command boundary."""
+        nonlocal seq
+        seq+=1
+        runtime.command(dict(protocol_version=2,session_id=session,lease_id=runtime.lease(session)['lease_id'],seq=seq,op=op,**values))
+
+    send('arm')
+    trace=[];index=0;label='initial';next_sample=0.0;max_attachment=0.0
+    ticks=int(round(request.duration_s/request.tick_s))
+    for step in range(ticks+1):
+        clock.time=step*request.tick_s
+        while index<len(request.events) and request.events[index].at_s<=clock.time+1e-9:
+            event=request.events[index];label=event.label
+            if event.op=='move':send('move',targets=event.targets,rates=event.rates,coordinated=True)
+            else:send('hold')
+            index+=1
+        if step%max(1,int(.1/request.tick_s))==0:send('heartbeat')
+        runtime.tick()
+        if runtime.state=='FAULT':raise RuntimeError(runtime.snapshot())
+        relative=adapter.relative_attachments()
+        for initial,current in zip(adapter.initial_relative,relative,strict=True):
+            max_attachment=max(max_attachment,float(np.max(np.abs(np.array(initial['position_m'])-current['position_m']))),float(np.max(np.abs(np.array(initial['rotation'])-current['rotation']))))
+        if clock.time+1e-9>=next_sample:
+            trace.append({'time_s':float(adapter.data.time),'host_time_s':clock.time,'phase':label,'qpos':adapter.data.qpos.tolist(),'qvel':adapter.data.qvel.tolist(),'ctrl':adapter.data.ctrl.tolist(),'feedback':runtime.snapshot(),'switches':adapter.observation(),'attachments':relative})
+            next_sample+=request.sample_s
+    result={'format':'forma.mujoco-trace','version':1,'configuration_sha256':hashlib.sha256(config_path.read_bytes()).hexdigest(),'request_sha256':hashlib.sha256(request_path.read_bytes()).hexdigest(),'engine':'MuJoCo','engine_version':__import__('mujoco').__version__,'runtime':'forma_core.control.runtime.MachineRuntime','frames':trace,'switch_events':adapter.events,'runtime_events':list(runtime.events),'max_attachment_transform_error':max_attachment,'final_feedback':runtime.snapshot()}
+    output.write_text(json.dumps(result,separators=(',',':')))
+    runtime.release(session)
+    return result
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('request',type=Path);parser.add_argument('output',type=Path)
+    args=parser.parse_args();result=run(args.request,args.output)
+    print(json.dumps({'frames':len(result['frames']),'switch_events':result['switch_events'],'attachment_error':result['max_attachment_transform_error']}))
