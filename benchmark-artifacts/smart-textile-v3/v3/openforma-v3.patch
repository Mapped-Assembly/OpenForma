index 0000000..5bf972e
--- /dev/null
+++ b/forma_core/control/mujoco_adapter.py
@@ -0,0 +1,269 @@
+"""Declaratively bound MuJoCo physics behind the existing MachineAdapter protocol.
+
+Position servos are virtual control aids, not evidence of human biomechanics or
+physical motor design. Contact switches report simulated state only.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import time
+import xml.etree.ElementTree as ET
+from collections.abc import Callable, Mapping
+from pathlib import Path
+from typing import Any, Literal
+
+import mujoco
+import numpy as np
+from pydantic import Field, FiniteFloat, model_validator
+
+from .models import AdapterDiagnostics, AxisFeedback, ControlModel, Feedback, MachineDefinition
+from .package import AdapterContract, ObservationSpec, digest
+
+
+class MJCFNode(ControlModel):
+    """JSON representation of an MJCF element; no executable code or includes."""
+    tag: str
+    attributes: dict[str, str] = Field(default_factory=dict)
+    children: list[MJCFNode] = Field(default_factory=list)
+
+    def element(self) -> ET.Element:
+        """Create an XML node after rejecting external code and file indirection."""
+        if self.tag in {'include', 'plugin', 'extension'}:
+            raise ValueError('MJCF includes and plugins are not allowed')
+        node = ET.Element(self.tag, self.attributes)
+        node.extend(child.element() for child in self.children)
+        return node
+
+
+class AxisBinding(ControlModel):
+    """Map a MachineDefinition axis to one scalar joint and position actuator."""
+    joint: str
+    actuator: str
+
+
+class ContactSwitch(ControlModel):
+    """Debounced contact plus optional spring-button travel; toggles on press."""
+    switch_id: str
+    geom_a: str
+    geom_b: str
+    travel_joint: str | None = None
+    minimum_travel_m: FiniteFloat = Field(default=0.0, ge=0)
+    debounce_s: FiniteFloat = Field(default=0.04, gt=0)
+    initial_state: bool = False
+
+
+class FixedAttachment(ControlModel):
+    """A fixed descendant body whose local transform must remain invariant."""
+    body: str
+    parent: str
+
+
+class HumanReference(ControlModel):
+    """Pin one optional HumanIR participant to simulator identities."""
+    file: str
+    sha256: str = Field(pattern=r'^[a-f0-9]{64}$')
+    participant_id: str
+
+
+class MujocoConfiguration(ControlModel):
+    """Versioned physics binding; the scene and all named identities are data."""
+    format: Literal['forma.mujoco-adapter'] = 'forma.mujoco-adapter'
+    version: Literal[1] = 1
+    definition: MachineDefinition
+    scene: MJCFNode
+    axes: dict[str, AxisBinding]
+    switches: list[ContactSwitch] = Field(default_factory=list)
+    attachments: list[FixedAttachment] = Field(default_factory=list)
+    body_bindings: dict[str, str] = Field(default_factory=dict)
+    joint_bindings: dict[str, list[str]] = Field(default_factory=dict)
+    asset_hashes: dict[str, str] = Field(default_factory=dict)
+    human: HumanReference | None = None
+
+    @model_validator(mode='after')
+    def identities(self) -> MujocoConfiguration:
+        """Reject ambiguous bindings before loading a simulator."""
+        if self.definition.backend != 'virtual' or self.scene.tag != 'mujoco':
+            raise ValueError('Configuration requires a virtual definition and MJCF root')
+        if set(self.axes) != {a.axis_id for a in self.definition.axes}:
+            raise ValueError('Axis bindings must exactly cover the machine definition')
+        if len({b.joint for b in self.axes.values()}) != len(self.axes) or len({b.actuator for b in self.axes.values()}) != len(self.axes):
+            raise ValueError('Each controlled joint and actuator needs a unique owner')
+        if len({s.switch_id for s in self.switches}) != len(self.switches):
+            raise ValueError('Duplicate contact switch identity')
+        return self
+
+
+def compile_scene(config: MujocoConfiguration, directory: Path) -> str:
+    """Compile JSON MJCF while checking every file against a pinned local asset."""
+    directory = directory.resolve()
+    root = config.scene.element()
+    for node in root.iter():
+        for key, value in node.attrib.items():
+            if key in {'meshdir', 'texturedir', 'assetdir'} and value not in {'', '.'}:
+                raise ValueError('Asset directory overrides are not supported')
+            if key == 'file':
+                path = (directory/value).resolve()
+                if not path.is_relative_to(directory) or value not in config.asset_hashes:
+                    raise ValueError('Every asset must be local and hash pinned')
+                if hashlib.sha256(path.read_bytes()).hexdigest() != config.asset_hashes[value]:
+                    raise ValueError(f'Asset digest mismatch: {value}')
+                node.set(key, str(path))
+    return ET.tostring(root, encoding='unicode')
+
+
+class MujocoAdapter:
+    """Advance a single MuJoCo state under MachineRuntime's clock and commands."""
+    mode = 'virtual'
+
+    def __init__(self, config: MujocoConfiguration, directory: Path, *, clock: Callable[[], float] = time.monotonic) -> None:
+        """Resolve named bindings and validate units, limits and fixed attachments."""
+        self.config, self.clock = config, clock
+        self.model = mujoco.MjModel.from_xml_string(compile_scene(config, directory))
+        self.data = mujoco.MjData(self.model)
+        self.enabled = False
+        self.last_tick = clock()
+        self.remainder = 0.0
+        self.ids: dict[str, tuple[int, int, float]] = {}
+        for axis in config.definition.axes:
+            binding = config.axes[axis.axis_id]
+            jid = self.model.joint(binding.joint).id
+            aid = self.model.actuator(binding.actuator).id
+            expected = mujoco.mjtJoint.mjJNT_HINGE if axis.unit == 'degree' else mujoco.mjtJoint.mjJNT_SLIDE
+            scale = math.pi/180 if axis.unit == 'degree' else .001
+            if self.model.jnt_type[jid] != expected or self.model.actuator_trnid[aid, 0] != jid:
+                raise ValueError('Axis unit/type or actuator transmission mismatch')
+            if not np.allclose(self.model.actuator_gear[aid], [1, 0, 0, 0, 0, 0]):
+                raise ValueError('Only unit-gear position actuators are supported')
+            if self.model.actuator_biastype[aid] != mujoco.mjtBias.mjBIAS_AFFINE or not math.isclose(self.model.actuator_biasprm[aid, 1], -self.model.actuator_gainprm[aid, 0]):
+                raise ValueError('Bound actuator must be a position servo')
+            for limited, limits in [(self.model.jnt_limited[jid], self.model.jnt_range[jid]), (self.model.actuator_ctrllimited[aid], self.model.actuator_ctrlrange[aid])]:
+                if not limited or axis.minimum*scale < limits[0]-1e-8 or axis.maximum*scale > limits[1]+1e-8:
+                    raise ValueError('Declared axis limits exceed simulator limits')
+            qadr = int(self.model.jnt_qposadr[jid])
+            self.ids[axis.axis_id] = (qadr, aid, scale)
+            self.data.qpos[qadr] = axis.neutral*scale
+            self.data.ctrl[aid] = axis.neutral*scale
+        self.switch_ids: dict[str, tuple[int, int, int | None]] = {}
+        self.states: dict[str, dict[str, Any]] = {}
+        for switch in config.switches:
+            qadr = None
+            if switch.travel_joint:
+                joint = self.model.joint(switch.travel_joint)
+                if self.model.jnt_type[joint.id] != mujoco.mjtJoint.mjJNT_SLIDE:
+                    raise ValueError('Button travel must be a slide joint in metres')
+                qadr = int(joint.qposadr[0])
+            self.switch_ids[switch.switch_id] = (self.model.geom(switch.geom_a).id, self.model.geom(switch.geom_b).id, qadr)
+            self.states[switch.switch_id] = {'pressed':False,'state':switch.initial_state,'press_count':0,'candidate':False,'candidate_time':0.0,'contact':False,'travel_m':0.0,'normal_force_n':0.0}
+        self.attachment_ids: list[tuple[int, int]] = []
+        for attachment in config.attachments:
+            child, parent = self.model.body(attachment.body).id, self.model.body(attachment.parent).id
+            walk = child
+            while walk != parent and walk != 0:
+                if self.model.body_jntnum[walk]:
+                    raise ValueError('Fixed attachment path includes a movable joint')
+                walk = int(self.model.body_parentid[walk])
+            if walk != parent:
+                raise ValueError('Attachment must be a fixed descendant of parent')
+            self.attachment_ids.append((child,parent))
+        for name in config.body_bindings.values():
+            self.model.body(name)
+        for names in config.joint_bindings.values():
+            for name in names:
+                self.model.joint(name)
+        if config.human:
+            from forma_core.domains.registry import parse_domain, validate_domain
+            file=(directory/config.human.file).resolve()
+            if not file.is_relative_to(directory.resolve()) or hashlib.sha256(file.read_bytes()).hexdigest()!=config.human.sha256:
+                raise ValueError('HumanIR path or digest mismatch')
+            payload=json.loads(file.read_text())
+            if payload.get('domain')!='human' or any(f.severity=='error' for f in validate_domain(payload)):
+                raise ValueError('Invalid native HumanIR document')
+            human=parse_domain(payload)
+            participant=next((p for p in human.participants if p.participant_id==config.human.participant_id),None)
+            if participant is None:
+                raise ValueError('Unknown HumanIR participant')
+            profile=next(p for p in human.profiles if p.profile_id==participant.profile_id and p.revision==participant.profile_revision)
+            if set(config.body_bindings)!={s.segment_id for s in profile.segments} or set(config.joint_bindings)!={j.joint_id for j in profile.joints}:
+                raise ValueError('Every HumanIR segment and joint needs an explicit binding')
+            for joint in profile.joints:
+                parent=self.model.body(config.body_bindings[joint.parent_segment_id]).id
+                child=self.model.body(config.body_bindings[joint.child_segment_id]).id
+                if self.model.body_parentid[child]!=parent or not config.joint_bindings[joint.joint_id]:
+                    raise ValueError('HumanIR joint ancestry differs from simulator')
+                for name in config.joint_bindings[joint.joint_id]:
+                    if self.model.jnt_bodyid[self.model.joint(name).id]!=child:
+                        raise ValueError('HumanIR joint is bound to the wrong body')
+        self.events: list[dict[str, Any]] = []
+        mujoco.mj_forward(self.model,self.data)
+        self.initial_relative = self.relative_attachments()
+
+    def relative_attachments(self) -> list[dict[str, Any]]:
+        """Read attachment transforms from executed world poses."""
+        values=[]
+        for child,parent in self.attachment_ids:
+            rotation=self.data.xmat[parent].reshape(3,3)
+            values.append({'body':self.model.body(child).name,'position_m':(rotation.T@(self.data.xpos[child]-self.data.xpos[parent])).tolist(),'rotation':(rotation.T@self.data.xmat[child].reshape(3,3)).reshape(-1).tolist()})
+        return values
+
+    def _observe_switches(self) -> None:
+        """Update switch state only from simulated contact and joint observations."""
+        for switch in self.config.switches:
+            a,b,qadr=self.switch_ids[switch.switch_id]
+            state=self.states[switch.switch_id]
+            force=0.0; contact=False
+            for index,c in enumerate(self.data.contact):
+                if {int(c.geom1),int(c.geom2)} == {a,b}:
+                    wrench=np.zeros(6);mujoco.mj_contactForce(self.model,self.data,index,wrench)
+                    force+=max(0.0,float(wrench[0]));contact=True
+            travel=float(self.data.qpos[qadr]) if qadr is not None else 0.0
+            raw=contact and force>0 and travel>=switch.minimum_travel_m
+            state.update(contact=contact,travel_m=travel,normal_force_n=force)
+            if raw != state['candidate']:
+                state.update(candidate=raw,candidate_time=float(self.data.time))
+            if raw != state['pressed'] and self.data.time-state['candidate_time'] >= switch.debounce_s:
+                state['pressed']=raw
+                if raw:
+                    state['state']=not state['state'];state['press_count']+=1
+                self.events.append({'time_s':float(self.data.time),'switch_id':switch.switch_id,'event':'press' if raw else 'release','state':state['state'],'travel_m':travel,'normal_force_n':force})
+
+    def apply(self, commands: Mapping[str, float | None], enabled: bool) -> None:
+        """Integrate elapsed enabled time, then apply the latest position setpoints."""
+        if set(commands)!=set(self.ids):
+            raise ValueError('Commands must cover exactly the bound axes')
+        for axis in self.config.definition.axes:
+            value=commands[axis.axis_id]
+            if value is not None and (not math.isfinite(value) or not axis.minimum<=value<=axis.maximum):
+                raise ValueError('Invalid axis command')
+        now=self.clock();elapsed=now-self.last_tick
+        if elapsed < -1e-9 or elapsed > .1:
+            raise ValueError('Physics host must use a monotonic clock and tick at least every 100 ms')
+        self.last_tick=now
+        if self.enabled:
+            self.remainder+=max(0.0,elapsed)
+            while self.remainder+1e-10>=self.model.opt.timestep:
+                mujoco.mj_step(self.model,self.data)
+                self.remainder-=self.model.opt.timestep
+                if not np.isfinite(self.data.qpos).all() or not np.isfinite(self.data.qvel).all():
+                    raise RuntimeError('Nonfinite MuJoCo state')
+                self._observe_switches()
+        self.enabled=enabled
+        if enabled:
+            for axis in self.config.definition.axes:
+                _,aid,scale=self.ids[axis.axis_id]
+                value=commands[axis.axis_id]
+                self.data.ctrl[aid]=(axis.neutral if value is None else value)*scale
+        mujoco.mj_forward(self.model,self.data)
+
+    def observation(self) -> dict[str, Any]:
+        """Return detached, simulated control-state observations."""
+        return json.loads(json.dumps(self.states))
+
+    def read(self) -> Feedback:
+        """Return simulator joint positions, never measured hardware values."""
+        return Feedback(mode='virtual',axes={key:AxisFeedback(simulated=float(self.data.qpos[q]/scale)) for key,(q,_,scale) in self.ids.items()},diagnostics=AdapterDiagnostics(kind='mujoco-configurable',status='RUNNING' if self.enabled else 'PAUSED',output_enabled=self.enabled,details={'simulation_time_s':float(self.data.time),'switches':self.observation()}))
+
+    def describe(self) -> AdapterContract:
+        """Advertise move support and revision-pinned simulation provenance."""
+        return AdapterContract(adapter_id='forma.mujoco-configurable',mode='virtual',evidence='contact-physics',configuration_sha256=digest(self.config.model_dump(mode='json')),actuators={key:value.actuator for key,value in self.config.axes.items()},handlers=['move'],observations={s.switch_id+'.state':ObservationSpec(path=[s.switch_id,'state'],value_type='boolean') for s in self.config.switches})
diff --git a/forma_core/control/mujoco_render.py b/forma_core/control/mujoco_render.py
new file mode 100644
index 0000000..b5068b0
--- /dev/null
+++ b/forma_core/control/mujoco_render.py
@@ -0,0 +1,67 @@
+"""Render recorded MuJoCo states; this viewer never advances simulation time."""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+import mujoco
+import numpy as np
+from PIL import Image, ImageDraw, ImageFont
+from .mujoco_adapter import MujocoConfiguration, compile_scene
+
+
+def camera(spec: dict[str, Any]) -> mujoco.MjvCamera:
+    """Create a free camera from declared presentation parameters."""
+    cam=mujoco.MjvCamera();cam.type=mujoco.mjtCamera.mjCAMERA_FREE
+    cam.lookat[:]=spec['lookat'];cam.distance=spec['distance'];cam.azimuth=spec['azimuth'];cam.elevation=spec['elevation']
+    return cam
+
+
+def render(config_path: Path, trace_path: Path, views_path: Path, output: Path) -> None:
+    """Render exactly the stored qpos/qvel/ctrl frames, without interpolation."""
+    config=MujocoConfiguration.model_validate_json(config_path.read_text())
+    trace=json.loads(trace_path.read_text());views=json.loads(views_path.read_text())
+    if trace['configuration_sha256']!=hashlib.sha256(config_path.read_bytes()).hexdigest():
+        raise ValueError('Trace/configuration digest mismatch')
+    model=mujoco.MjModel.from_xml_string(compile_scene(config,config_path.parent));data=mujoco.MjData(model)
+    renderers=[mujoco.Renderer(model,height=v['height'],width=v['width']) for v in views['panels']]
+    cams=[camera(v) for v in views['panels']]
+    font=ImageFont.truetype(views['font'],23);small=ImageFont.truetype(views['font'],16);bold=ImageFont.truetype(views['font'],28)
+    frames=[];pressed_saved=False
+    for index,frame in enumerate(trace['frames']):
+        data.qpos[:]=frame['qpos'];data.qvel[:]=frame['qvel'];data.ctrl[:]=frame['ctrl'];data.time=frame['time_s']
+        mujoco.mj_forward(model,data)
+        canvas=Image.new('RGB',(views['width'],views['height']),'#edf2f7');draw=ImageDraw.Draw(canvas)
+        draw.text((24,14),views['title'],font=bold,fill='#102a43')
+        draw.text((24,54),f"t = {frame['time_s']:05.2f} s  |  {frame['phase']}",font=small,fill='#42566c')
+        for panel,renderer,cam in zip(views['panels'],renderers,cams,strict=True):
+            renderer.update_scene(data,camera=cam)
+            pixels=renderer.render()
+            canvas.paste(Image.fromarray(pixels),(panel['x'],panel['y']))
+        switch=frame['switches'][views['switch_id']]
+        status=views['status']
+        fields={**switch,'travel_mm':1000*switch['travel_m'],'state_label':status['on_label'] if switch['state'] else status['off_label'],'pressed_label':status['pressed_label'] if switch['pressed'] else status['released_label']}
