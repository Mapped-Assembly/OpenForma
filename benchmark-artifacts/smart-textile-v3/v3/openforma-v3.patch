@@ -0,0 +1,116 @@
+"""Reusable layered flexible assemblies; no cloth or structural solver implied."""
+from __future__ import annotations
+from typing import TYPE_CHECKING, Literal
+from pydantic import Field, model_validator
+from forma_core.domains.base import DomainModel, Finding, Text, unique
+if TYPE_CHECKING:
+    from .models import MechanicalIR
+
+
+class DirectionalFlexibility(DomainModel):
+    """Material-axis properties and limits; null remains unknown, not isotropic."""
+    warp_modulus_pa: float | None = Field(default=None, gt=0)
+    weft_modulus_pa: float | None = Field(default=None, gt=0)
+    shear_modulus_pa: float | None = Field(default=None, gt=0)
+    warp_bending_rigidity_nm: float | None = Field(default=None, ge=0)
+    weft_bending_rigidity_nm: float | None = Field(default=None, ge=0)
+    maximum_warp_strain: float | None = Field(default=None, ge=0)
+    maximum_weft_strain: float | None = Field(default=None, ge=0)
+    minimum_bend_radius_mm: float | None = Field(default=None, gt=0)
+    evidence_uri: Text | None = None
+    evidence_sha256: str | None = Field(default=None, pattern=r'^[a-f0-9]{64}$')
+
+    @model_validator(mode='after')
+    def evidence_pair(self) -> DirectionalFlexibility:
+        """A claimed evidence source must be both locatable and content-pinned."""
+        if (self.evidence_uri is None)!=(self.evidence_sha256 is None):
+            raise ValueError('Material evidence requires both URI and SHA-256')
+        return self
+
+
+class MaterialLayer(DomainModel):
+    """One physical component occurrence within an ordered material stack."""
+    layer_id: Text
+    component_object_id: Text
+    thickness_mm: float | None = Field(default=None, gt=0)
+    material_angle_deg: float = 0.0
+    role: Literal['structural', 'insulation', 'dielectric', 'conductor', 'encapsulation', 'contact', 'spreader', 'storage', 'other']
+
+
+class LayerJoin(DomainModel):
+    """Declared connection of adjacent layers; heat resistance belongs to ThermalIR."""
+    join_id: Text
+    first_layer_id: Text
+    second_layer_id: Text
+    method: Literal['sewn', 'laminated', 'adhesive', 'clamped', 'contact', 'unknown'] = 'unknown'
+    geometry_refs: list[Text] = Field(default_factory=list)
+
+
+class LayeredAssembly(DomainModel):
+    """List order runs along the declared positive normal in the named CAD frame."""
+    stack_id: Text
+    host_object_id: Text
+    frame: Text
+    normal: list[float] = Field(min_length=3, max_length=3)
+    warp_direction: list[float] = Field(min_length=3, max_length=3)
+    layers: list[MaterialLayer] = Field(min_length=1)
+    joins: list[LayerJoin] = Field(default_factory=list)
+
+    @model_validator(mode='after')
+    def topology(self) -> LayeredAssembly:
+        """Reject ambiguous material frames, repeated layers and nonadjacent joins."""
+        for vector in (self.normal,self.warp_direction):
+            if abs(sum(x*x for x in vector)-1)>1e-6:
+                raise ValueError('Layer frame directions must be unit vectors')
+        if abs(sum(a*b for a,b in zip(self.normal,self.warp_direction)))>1e-6:
+            raise ValueError('Warp direction must lie in the layer plane')
+        ids=[layer.layer_id for layer in self.layers]
+        unique(ids,'layer ID');unique([layer.component_object_id for layer in self.layers],'layer occurrence')
+        unique([join.join_id for join in self.joins],'join ID')
+        adjacent={frozenset(pair) for pair in zip(ids,ids[1:])};joined=set()
+        for join in self.joins:
+            pair=frozenset((join.first_layer_id,join.second_layer_id))
+            if pair not in adjacent or pair in joined:
+                raise ValueError('Joins must connect distinct adjacent layers exactly once')
+            joined.add(pair)
+        return self
+
+
+def validate_layer_references(document: MechanicalIR) -> None:
+    """Resolve layer occurrences and reject collisions in the public entity index."""
+    objects={c.object_id for c in document.components}
+    entity_ids=list(objects);occurrences=[]
+    for stack in document.layered_assemblies:
+        entity_ids.extend([stack.stack_id,*[layer.layer_id for layer in stack.layers],*[join.join_id for join in stack.joins]])
+        if stack.host_object_id not in objects:
+            raise ValueError('Layer stack host must be an existing mechanical occurrence')
+        for layer in stack.layers:
+            if layer.component_object_id not in objects or layer.component_object_id==stack.host_object_id:
+                raise ValueError('Layer must reference a distinct existing component occurrence')
+            occurrences.append(layer.component_object_id)
+    unique(entity_ids,'mechanical entity ID');unique(occurrences,'physical layer occurrence across stacks')
+
+
+def inspect_layers(document: MechanicalIR) -> list[dict]:
+    """Report declared thickness accounting without implying a physical evaluation."""
+    from .models import MechanicalIR
+    document = MechanicalIR.model_validate(document.model_dump(mode='json'))
+    return [{'stack_id':stack.stack_id,'layer_order':[layer.layer_id for layer in stack.layers],
+             'total_thickness_mm':None if any(layer.thickness_mm is None for layer in stack.layers) else sum(layer.thickness_mm for layer in stack.layers),
+             'geometry_check':'unsupported','deformation_prediction':'unsupported'} for stack in document.layered_assemblies]
+
+
+def layer_findings(document: MechanicalIR) -> list[Finding]:
+    """Expose absent material evidence and incomplete construction declarations."""
+    parts={p.part_definition_id:p for p in document.parts};objects={c.object_id:c for c in document.components}
+    findings=[]
+    for stack in document.layered_assemblies:
+        if len(stack.joins)<len(stack.layers)-1:
+            findings.append(Finding(code='unknown_layer_join',location=stack.stack_id,severity='warning',message='At least one adjacent interface has no joining declaration.'))
+        for layer in stack.layers:
+            part=parts[objects[layer.component_object_id].part_definition_id]
+            if layer.thickness_mm is None:
+                findings.append(Finding(code='unknown_layer_thickness',location=layer.layer_id,severity='warning',message='Nominal layer thickness is unknown.'))
+            if part.flexibility is None or part.flexibility.evidence_sha256 is None:
+                findings.append(Finding(code='unknown_flexible_material',location=layer.layer_id,severity='warning',message='Directional deformation properties lack pinned evidence; flexibility is not verified.'))
+    return findings
