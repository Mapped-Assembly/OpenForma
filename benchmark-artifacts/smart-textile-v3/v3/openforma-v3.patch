+"""Exercise the generic adapter on a sliding contact fixture, not a wearable."""
+from __future__ import annotations
+import hashlib
+import json
+import importlib.util
+import tempfile
+import unittest
+from pathlib import Path
+from typing import Any
+
+HAS_MUJOCO=importlib.util.find_spec('mujoco') is not None
+if HAS_MUJOCO:
+    from forma_core.control.mujoco_adapter import MujocoAdapter, MujocoConfiguration
+    from forma_core.control.mujoco_run import SimulationClock
+    from forma_core.control.runtime import MachineRuntime
+
+
+def fixture() -> dict[str, Any]:
+    """Describe a one-axis pusher and an independent spring-loaded switch."""
+    def node(tag: str, attributes: dict[str,str] | None = None, children: list[dict[str,Any]] | None = None) -> dict[str, Any]:
+        """Build a JSON MJCF element for this test fixture."""
+        return {'tag':tag,'attributes':attributes or {},'children':children or []}
+    return {'definition':{'machine_id':'slide','name':'Sliding contact fixture','axes':[{'axis_id':'x','label':'X','unit':'mm','minimum':0.,'maximum':20.,'neutral':0.,'max_rate':10.}]},'axes':{'x':{'joint':'x','actuator':'x'}},'scene':node('mujoco',children=[node('option',{'gravity':'0 0 0','timestep':'0.002','integrator':'implicitfast'}),node('worldbody',children=[node('body',{'name':'pusher'},[node('joint',{'name':'x','type':'slide','axis':'1 0 0','range':'0 .02','damping':'1'}),node('geom',{'name':'pusher-geom','type':'box','size':'.01 .01 .01','mass':'.1'})]),node('body',{'name':'button','pos':'.025 0 0'},[node('joint',{'name':'button-slide','type':'slide','axis':'1 0 0','range':'0 .006','stiffness':'100','damping':'1'}),node('geom',{'name':'button-geom','type':'box','size':'.01 .01 .01','mass':'.01'})])]),node('actuator',children=[node('position',{'name':'x','joint':'x','kp':'1000','kv':'40','ctrlrange':'0 .02'})])]),'switches':[{'switch_id':'switch','geom_a':'pusher-geom','geom_b':'button-geom','travel_joint':'button-slide','minimum_travel_m':.001,'debounce_s':.03}]}
+
+
+@unittest.skipUnless(HAS_MUJOCO,'optional MuJoCo dependency unavailable')
+class MujocoAdapterTests(unittest.TestCase):
+    """Check physics, provenance, contacts and rejection of invalid bindings."""
+    def setUp(self) -> None:
+        """Create a fresh adapter with a deterministic host clock."""
+        self.clock=SimulationClock();self.directory=tempfile.TemporaryDirectory()
+        self.config=MujocoConfiguration.model_validate(fixture())
+        self.adapter=MujocoAdapter(self.config,Path(self.directory.name),clock=self.clock)
+
+    def tearDown(self) -> None:
+        """Remove temporary assets after the test."""
+        self.directory.cleanup()
+
+    def advance(self, target: float, seconds: float) -> None:
+        """Advance fixed steps with the same setpoint."""
+        for _ in range(round(seconds/.01)):
+            self.clock.time+=.01;self.adapter.apply({'x':target},True)
+
+    def test_contact_toggles_once_per_press_and_requires_release(self) -> None:
+        """Holding contact must not create repeated toggle events."""
+        self.adapter.apply({'x':8.},True);self.advance(8.,1.)
+        self.assertEqual(self.adapter.observation()['switch']['press_count'],1)
+        self.assertTrue(self.adapter.observation()['switch']['state'])
+        self.advance(8.,.5);self.assertEqual(self.adapter.observation()['switch']['press_count'],1)
+        self.advance(0.,.7);self.assertFalse(self.adapter.observation()['switch']['pressed'])
+        self.advance(8.,.8);self.assertEqual(self.adapter.observation()['switch']['press_count'],2)
+        self.assertFalse(self.adapter.observation()['switch']['state'])
+        self.assertTrue(all(e['normal_force_n']>0 for e in self.adapter.events if e['event']=='press'))
+
+    def test_feedback_is_physics_and_pauses_when_disarmed(self) -> None:
+        """Setpoints are not returned as simulated joint positions."""
+        self.adapter.apply({'x':4.},True)
+        self.assertEqual(self.adapter.read().axes['x'].simulated,0.)
+        self.advance(4.,.6)
+        feedback=self.adapter.read().axes['x']
+        self.assertAlmostEqual(feedback.simulated,4.,delta=.1);self.assertIsNone(feedback.measured)
+        self.adapter.apply({'x':None},False);before=self.adapter.data.time
+        for _ in range(5):self.clock.time+=.01;self.adapter.apply({'x':None},False)
+        self.assertEqual(self.adapter.data.time,before)
+
+    def test_travel_without_contact_does_not_toggle(self) -> None:
+        """An externally displaced button is not a palm/contact event."""
+        q=self.adapter.switch_ids['switch'][2];self.adapter.data.qpos[q]=.004
+        for i in range(100):
+            self.adapter.data.time=i*.01;self.adapter._observe_switches()
+        self.assertEqual(self.adapter.observation()['switch']['press_count'],0)
+
+    def test_invalid_axis_units_and_attachment_are_rejected(self) -> None:
+        """Wrong joint units and movable attachment paths cannot validate."""
+        raw=fixture();raw['definition']['axes'][0]['unit']='degree'
+        with self.assertRaisesRegex(ValueError,'unit/type'):
+            MujocoAdapter(MujocoConfiguration.model_validate(raw),Path(self.directory.name),clock=self.clock)
+        raw=fixture();raw['attachments']=[{'body':'button','parent':'world'}]
+        with self.assertRaisesRegex(ValueError,'movable joint'):
+            MujocoAdapter(MujocoConfiguration.model_validate(raw),Path(self.directory.name),clock=self.clock)
+
+    def test_bad_command_is_atomic_and_clock_fault_disables(self) -> None:
+        """Reject invalid outputs and surface an integration gap as a runtime fault."""
+        before=self.adapter.data.ctrl.copy()
+        with self.assertRaises(ValueError):self.adapter.apply({'x':float('nan')},True)
+        self.assertEqual(self.adapter.data.ctrl.tolist(),before.tolist())
+        runtime=MachineRuntime(self.config.definition,self.adapter,clock=self.clock)
+        self.clock.time=.2;runtime.tick()
+        self.assertEqual(runtime.state,'FAULT');self.assertFalse(self.adapter.enabled)
+
+    def test_human_reference_digest_and_complete_bindings(self) -> None:
+        """Pin a native participant and reject changed source or missing mappings."""
+        human={'domain':'human','schema_version':'1.0','artifact_id':'test-human','revision':1,'profiles':[{'profile_id':'nominal','revision':1,'source':{'kind':'synthetic','description':'Test only'},'segments':[{'segment_id':'hand','label':'Hand'}]}],'participants':[{'participant_id':'person','profile_id':'nominal','profile_revision':1,'roles':['operator']}]}
+        path=Path(self.directory.name)/'human.json';path.write_text(json.dumps(human))
+        raw=fixture();raw['human']={'file':'human.json','sha256':hashlib.sha256(path.read_bytes()).hexdigest(),'participant_id':'person'};raw['body_bindings']={'hand':'pusher'}
+        MujocoAdapter(MujocoConfiguration.model_validate(raw),Path(self.directory.name),clock=self.clock)
+        missing=dict(raw);missing['body_bindings']={}
+        with self.assertRaisesRegex(ValueError,'Every HumanIR'):
+            MujocoAdapter(MujocoConfiguration.model_validate(missing),Path(self.directory.name),clock=self.clock)
+        path.write_text('{}')
+        with self.assertRaisesRegex(ValueError,'digest mismatch'):
+            MujocoAdapter(MujocoConfiguration.model_validate(raw),Path(self.directory.name),clock=self.clock)
+
+    def test_external_assets_and_include_are_rejected(self) -> None:
+        """JSON scene loading cannot bypass pinned local assets."""
+        raw=fixture();raw['scene']['children'].append({'tag':'include','attributes':{'file':'other.xml'}})
+        with self.assertRaisesRegex(ValueError,'includes'):
+            MujocoAdapter(MujocoConfiguration.model_validate(raw),Path(self.directory.name),clock=self.clock)
+        raw=fixture();raw['scene']['children'].append({'tag':'asset','children':[{'tag':'mesh','attributes':{'name':'mesh','file':'../outside.obj'}}]})
+        with self.assertRaisesRegex(ValueError,'local and hash pinned'):
+            MujocoAdapter(MujocoConfiguration.model_validate(raw),Path(self.directory.name),clock=self.clock)
+
+
+if __name__=='__main__':
+    unittest.main()
