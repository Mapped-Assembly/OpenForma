diff --git a/forma_core/domains/layer_coupling.py b/forma_core/domains/layer_coupling.py
new file mode 100644
index 0000000..279dc89
--- /dev/null
+++ b/forma_core/domains/layer_coupling.py
@@ -0,0 +1,54 @@
+"""Typed layered-material relationships within the existing product composition."""
+from __future__ import annotations
+from typing import TYPE_CHECKING
+from pydantic import BaseModel
+from .base import Finding
+if TYPE_CHECKING:
+    from .composition import DomainLink
+
+RELATIONSHIPS={'mounted_on_layer','thermal_representation','observes_temperature','wearer_contact','thermal_contact'}
+
+
+def validate_layer_link(link: DomainLink, source: BaseModel | None, target: BaseModel | None) -> list[Finding]:
+    """Check endpoint meaning, never infer strain, heat transfer or sensor values."""
+    def error(message: str) -> list[Finding]:
+        """Return one composition finding scoped to this relationship."""
+        return [Finding(code='layer_coupling',location=link.link_id,message=message)]
+    if source is None or target is None:
+        return error('Layered-material coupling requires supported native endpoint semantics.')
+    kinds={'mounted_on_layer':('electrical','mechanical'),'thermal_representation':('mechanical','thermal'),
+           'observes_temperature':('electrical','thermal'),'wearer_contact':('human','mechanical'),'thermal_contact':('human','thermal')}
+    if (source.domain,target.domain)!=kinds[link.kind]:
+        return error(f'{link.kind} requires domains {kinds[link.kind]}.')
+    if link.kind=='mounted_on_layer':
+        if link.source.port_id is not None or link.target.port_id is not None:
+            return error('Mounting binds an electrical component occurrence to a whole material layer.')
+        if link.source.object_id not in {c.object_id for c in source.components}:
+            return error('Mounted source must be an electrical component occurrence.')
+        if link.target.object_id not in {layer.layer_id for stack in target.layered_assemblies for layer in stack.layers}:
+            return error('Mount target must be a declared material layer.')
+    elif link.kind=='thermal_representation':
+        valid={c.object_id for c in source.components}|{layer.layer_id for stack in source.layered_assemblies for layer in stack.layers}
+        if link.source.port_id is not None or link.target.port_id is not None or link.source.object_id not in valid or link.target.object_id not in {node.node_id for node in target.nodes}:
+            return error('Thermal representation binds a whole physical component/layer to a thermal node.')
+    elif link.kind=='observes_temperature':
+        component=next((c for c in source.components if c.object_id==link.source.object_id),None)
+        part=next((p for p in source.parts if component and p.part_definition_id==component.part_definition_id),None)
+        if part is None or part.engineering is None or part.engineering.temperature_sensor is None:
+            return error('Temperature observation source must declare a typed temperature-sensor role.')
+        if link.source.port_id is not None or link.target.port_id is not None or link.target.object_id not in {n.node_id for n in target.nodes}:
+            return error('Temperature observation binds a whole sensor to a thermal node, not an electrical pin or heat port.')
+    else:
+        participant=next((p for p in source.participants if p.participant_id==link.source.object_id),None)
+        port=next((p for p in participant.interfaces if p.port_id==link.source.port_id),None) if participant else None
+        required='mechanical_contact' if link.kind=='wearer_contact' else 'thermal_exchange'
+        if port is None or port.kind!=required or port.segment_id is None:
+            return error(f'Human endpoint needs a segment-bound {required} interface.')
+        if link.kind=='wearer_contact':
+            exposed={layer.layer_id:layer for stack in target.layered_assemblies for layer in (stack.layers[0],stack.layers[-1])}
+            layer=exposed.get(link.target.object_id)
+            if layer is None or layer.role!='contact' or link.target.port_id is not None:
+                return error('Wearer contact requires an exposed contact-role layer, not an internal layer.')
+        elif not any(n.node_id==link.target.object_id and any(p.port_id==link.target.port_id for p in n.ports) for n in target.nodes):
+            return error('Human thermal contact requires an explicit heat port on a thermal node.')
+    return []
