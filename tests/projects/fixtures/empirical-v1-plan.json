        },
        {
          "step_id": "before",
          "operation_id": "react",
          "depends_on": [
            "inputs"
          ],
          "preconditions": [],
          "description": "Record ambient temperature. Weigh the entire tray, bowl with vinegar, powder cup with bicarbonate, and spoon together; record initial total mass. All these items must remain in the final weighed system."
        },
        {
          "step_id": "mix",
          "operation_id": "react",
          "depends_on": [
            "before"
          ],
          "preconditions": [],
          "description": "Slowly add the powder to the vinegar in the open bowl, keeping the empty cup and spoon on the tray. Stir gently without splashing. Record start time and any spills or losses. Keep the vessel open throughout."
        },
        {
          "step_id": "after",
          "operation_id": "gas-output",
          "depends_on": [
            "mix"
          ],
          "preconditions": [],
          "description": "After visible bubbling subsides, take mass readings one minute apart until two consecutive readings differ by no more than 0.02 g, or stop at 15 minutes and mark incomplete. Record final total mass, elapsed time and a photograph of the final scale reading. A stable mass does not prove chemical completion."
        },
        {
          "step_id": "record",
          "operation_id": "residue-output",
          "depends_on": [
            "after"
          ],
          "preconditions": [],
          "description": "Submit the two total-mass readings, instrument resolution and defensible uncertainty bounds, temperature, evidence and deviations. Do not confirm proxy assumptions after a spill. Retain residue until readings are recorded; clean the ordinary food-ingredient mixture with water. Repeat with fresh independent batches to assess repeatability."
        }
